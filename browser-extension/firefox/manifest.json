{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://auth.openai.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://auth.x.ai/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SubscriptionBar"
  },
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "subscriptionbar@local.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteContent"
        ]
      }
    }
  }
}
